/* COMPLÉMENTS */

/* 01 — NAVIGATION, BOUTONS ET MODÉRATION */

.navigation_links {
  display: flex;
  justify-content: space-between;
  margin: 10px 0;
}

.navigation_chain {
  font-size: 0;

}

.navigation_chain a {
  font-size: initial;

  margin-right: 8px;
}

.navigation_chain a:before {
  content: "›";

  font-size: var(--normal-size);
  margin-right: 3px;
}

.buttons {
  background: var(--neutralDark);
    padding: 4px 8px;
  margin-right: 5px;
  border-radius: 5px;
  opacity: 1;
}

.buttons:hover {
  opacity: 0.7;
}

#moderation_forum_tools,
#moderation_forum_tools strong {
  font-size: 0px;
}

#moderation_forum_tools a {
  background: var(--neutralDark);
  border-radius: 5px;
  padding: 2px 8px;
  font-size: var(--normal-size);
}

/* 02 — DESCRIPTION DU FORUM */

.forum-page_desc {
  margin: 0 0 20px;
  background: var(--neutral);
  border-radius: 5px;
  padding: 10px;
}

/* 03 — ICÔNES COMPLÉMENTAIRES DES SUJETS */

.topic_msgicon {
  margin-right: 5px;
}

.topic_msgicon:empty {
  display: none;
}

.topiclist-infos img {
  margin-right: 3px;
}

/* 04 — SÉPARATEUR ET TRI DES SUJETS */

.topic_separator {
  height: 5px;
  background: var(--neutral);
  margin-bottom: 10px;
  border-radius: 5px;
}

#sort-topics {
  position: relative;
  display: inline;
  background: var(--neutralDark);
  margin: 10px 0;
}

.sort-form {
  width: max-content;
  background: var(--neutral);
  border: 1px solid var(--neutralDarker);
  border-radius: 5px;
  padding: 10px;
  position: absolute;
  top: 110%;
  right: 0;
  display: none;
}

.expanded ~ .sort-form {
  display: block;
}

/* 05 — RÉCOMPENSES ET RÉPONSE RAPIDE */

#list_awards {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
}

.award {
    width: 40px;
    height: 40px;
    position: relative;
    background-image: var(--award-image);
    background-size: cover;
    background-position: center;
    border-radius: 100%;
    cursor: pointer;
}

.award:hover .award_tooltiptext {
  display: block;
}

.award_tooltiptext {
  width: max-content;
  display: none;
  position: absolute;
  top: 25%;
  left: 25px;
  background-color: var(--neutral);
  border: 1px solid var(--neutralDark);
  padding: 5px;
  border-radius: 5px;
  text-align: center;
  font-size: 11px;
}

.award_tooltiptext_title {
  font-weight: 600;
}

.quickreply div.h3 {display: none}

.quickreply {
    display: flex;
    justify-content: center;
}

#quickreply_content:empty {display: none}

/* 06 — SONDAGES */

.poll {
    background: var(--neutral);
    border-radius: 5px;
    margin-bottom: 10px;
}

.head_poll {
    padding: 10px;
    border-bottom: 1px solid var(--neutralDark);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.poll_list {
    display: grid;
    grid-template-columns: 220px auto;
}

.poll_option {
    padding: 10px 20px 0 10px;
    border-right: 1px solid var(--neutralDark);
    text-align: right;
}

.poll_vote {
    padding: 10px 10px 0 20px;
}

.poll_send {
    margin-left: 220px;
    padding: 20px 10px 20px 20px;
    border-left: 1px solid var(--neutralDark);
}

.poll_vote:nth-child(2),
.poll_option:first-child {
    padding-top: 20px;
}

.votes-users-list {
    justify-content: start;
    margin: 20px 0 0;
}

/* 07 — CODE, SPOILERS, CITATIONS, CONTENU MASQUÉ ET MENTIONS */

/* .mentiontag : aucune déclaration dans la source, apparence héritée. */

.codebox {
  display: block;
  width: 90%;
  margin: 0 auto;
  position: relative;
}

.codebox dd {
  background: var(--neutralDark);
  border-radius: 5px;
  padding: 5px;
}

.codebox dt {
  font-weight: 700;
  font-size: var(--little-size);
}

#codeBox dt {
  height: 0;
  font-size: 0;
}

.copyCode {
  font-size: 12px;
  font-weight: normal;
  position: absolute;
  top: 5px;
  right: 13px;
  font-family: monospace;
  text-transform: uppercase;
  cursor: pointer;
}

div.cont_code {
  clear: right;
}

/* .hidebox.spoiler : apparence fournie par .codebox et les états ci-dessous. */

.spoiler_content {
  display: none;
}

.spoiler_content.hidden {
  display: block;
}

blockquote div {
  padding-left: 20px;
}

blockquote cite {
  display: block;
  margin-left: -20px;
  font-style: normal;
}

blockquote cite a {
  text-decoration: none !important;
}

.codebox.hidecode dd {
  background: transparent;
  opacity: 0.8;
}

/* 08 — ACTIONS DU PROFIL CLASSIQUE */

.followBtn {
  background: var(--neutral);
  border: 1px solid var(--neutralDark);
  border-radius: 5px;
  font-weight: 600;
  margin: 0;
  font-size: 14px;
}

.followBtn::before {
  top: 1px;
  position: relative;
  color: var(--accentClr);
  margin-right: 5px;
}

.ajax-profil_edit {
  cursor: pointer;
  position: absolute;
  top: 0;
  left: -15px;
}

.ajax-profil_valid {
  cursor: pointer;
  margin-left: 4px;
  vertical-align: middle;
}

/* 09 — ÉDITEUR ET PRÉVISUALISATION */

.message-edition {
  display: flex;
  flex-direction: row;

  gap: 15px;

}

#preview {
    background: var(--transparent-two);
  padding: 10px;
  border-radius: var(--radius-medium);
}

/* 10 — MODIFICATION DU PROFIL ET SIGNATURE */

#tabs ul {
  display: flex;
  justify-content: space-between;
  margin: 20px 0 10px;
}

#tabs li {
  padding: 5px 10px;
  border: 1px solid transparent;
}

#tabs li.activetab {
  background: var(--neutralDark);
  border: var(--border);
  border-radius: 5px;
}

#tabs li:hover {
  background: var(--neutralDark);
  border-radius: 5px;
  border: var(--border);
}

div#tabs li:nth-child(5) {
  display: none;
}

.profil_preferences dl,
.profil_editavatar dl {
  grid-template-columns: 40% auto;
}

.profil_preferences .italic {
  font-size: var(--little-size);
}

#parent_editor_simple > #smiley-box {
  float: left;

}

#parent_editor_simple #message-box {
  margin-left: 240px;

}

#parent_editor_simple #message-box > br {
  display: none;
}

#parent_editor_simple #message-box > #textarea_content {
  width: 100% !important;
}

.panel.row2.sig {
  text-align: center;
  margin-top: 10px;
}

/* 11 — RÉSULTATS DE RECHERCHE */

.post_search {
  display: grid;
  grid-template-columns: 200px auto;
  border-radius: 5px;
  margin: 10px 0;
  background: var(--neutral);
}

.post_search > div {
  padding: 10px;
}

.postsearch_infos {
  border-right: var(--border);
  font-size: var(--little-size);
}

/* 12 — CONNEXION */

form[name="form_login"],
form[name="form_login"] ~ .panel {
  text-align: center;
}

form[name="form_login"] .content {
  display: grid;
  justify-content: center;
  justify-items: center;
}

/* 13 — FENÊTRES DE RECHERCHE */

.overview {
  background: var(--neutral);
  border-radius: 5px;
  border: var(--border);
  padding: 10px;
  position: fixed !important;
  top: 50% !important;
}

.overview button[type="submit"] {
  width: 26px;
  height: 26px;
  margin-left: 5px;
}

.overview div {
  margin-bottom: 5px;
}

.overview a {
  float: right;
}

#find_username {
  display: none;
  position: fixed;
  left: 50%;
  width: 450px;
  margin-left: -225px;
  top: 50%;
  margin-top: -125px;
  background-color: var(--neutral);
  padding: 10px;
  border: var(--border);
  border-radius: 5px;
}
